# Copy to .env and set real values. Do not commit .env.

# Flask
APP_ENV=development
PORT=5000

# Required in production — use long random strings (e.g. openssl rand -hex 32)
SECRET_KEY=change-me-to-a-long-random-secret
JWT_SECRET_KEY=change-me-to-another-long-random-secret

# Global account registry (emails/passwords). One POS database per registered email.
# REGISTRY_DATABASE_URL=sqlite:///instance/registry.db

# Optional: legacy single-database file for `flask migrate-legacy-tenant`
# LEGACY_DATABASE_URL=sqlite:///instance/pos_system.db

# Optional JWT settings
# JWT_ALGORITHM=HS256
# JWT_EXPIRES_SECONDS=3600
